@page "/alunos"
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="aluno-container">
    <!-- Header -->
    <div class="aluno-header">
        <button class="btn" @onclick="Voltar">
            <span class="material-symbols-outlined">⬅️</span>
            Voltar para Importar
        </button>
        <h2>Sistema de Notas - Lista de Alunos</h2>
    </div>

    <!-- Search & Sort -->
    <div class="aluno-filtros">
        <input type="text" class="input" placeholder="Pesquisar por nome..." @bind="searchTerm" />
        <button class="btn" @onclick="OrdenarAlfabeticamente">
            Ordenar A-Z
        </button>
    </div>

    <!-- Lista de Alunos -->
    <div class="lista-alunos">
        @foreach (var aluno in alunosFiltrados)
        {
            <div class="aluno-card">
                <span>@aluno</span>
                <div class="acoes">
                    <button class="btn-icon" title="Excluir">
                        <span class="material-symbols-outlined text-danger">🗑️</span>
                    </button>
                    <button class="btn-icon" title="Ver" @onclick="NavegarParaConselho">
                        <span class="material-symbols-outlined text-info">👁️</span>
                    </button>
                    <button class="btn-icon" title="Editar">
                        <span class="material-symbols-outlined text-warning">✏️</span>
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<string> alunos = new() {
        "JOÃO SILVA SANTOS",
        "MARIA OLIVEIRA COSTA",
        "VITORIA BRITO MOTA"
    };

    private string searchTerm = "";

    private IEnumerable<string> alunosFiltrados =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? alunos
            : alunos.Where(a => a.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    private void OrdenarAlfabeticamente()
    {
        alunos = alunos.OrderBy(a => a).ToList();
    }

    private void NavegarParaConselho() => Navigation.NavigateTo("/conselho");
    private void Voltar() => Navigation.NavigateTo("/");
}


