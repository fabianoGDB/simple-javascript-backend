@page "/"
<PageTitle>Importar Planilhas</PageTitle>

@using System.IO
@using Services
@using Microsoft.AspNetCore.Components.Forms
@using NetcodeHub.Packages.Components.Toast
@inject FileService fileService





<div class="page-wrapper">

    <NetcodeHubToast @ref="Toast"
    Position="@ToastPosition.Top()"
    IconClass="bi bi-check"
    Persist="true"
    Duration=4000 />
    <div class="card">
        <form @onsubmit="OnSubmit">
            <div class="icon">📄</div>
            <h2>Sistema de Notas</h2>
            <p>Importe sua planilha de notas para visualizar os dados dos alunos</p>

            <div class="upload-wrapper">
                <label for="upload" class="upload-label">
                    <span>📤 Importar</span>
                </label>
                <InputFile id="upload" class="input-hidden" OnChange="OnInputFileChange" />
            </div>


            <p class="formats">Formatos suportados: .xlsx</p>
            <button class="btn" type="submit">Importar Planilha</button>
        </form>
    </div>
</div>

@code {
    NetcodeHubToast? Toast;
    List<string> RequiredEx = [".xlsx"];
    IBrowserFile? selectedFile;

    void OnInputFileChange(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
    }

    async Task OnSubmit()
    {
        if (selectedFile is null){
            await Toast.ShowDangerToast("Importação", $"Planilha não selecionada!");
            return;
        }

        var response = await fileService.UploadFile(selectedFile);
        await Toast.ShowInfoToast("Importação", $"Processo iniciado aguarde um momento!");
    }
}


    <style>
    .page-wrapper {
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

