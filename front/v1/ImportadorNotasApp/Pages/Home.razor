        width: 90%;
        color: #e0e0e0;
    }

    .icon {
        font-size: 40px;
        background-color: #2c2f45;
        color: #4da6ff;
        border-radius: 50%;
        width: 60px;
        height: 60px;
        display: flex;
        justify-content: center;
        align-items: center;
        margin: 0 auto 20px auto;
    }

    h2 {
        margin-bottom: 10px;
        color: #f0f0f0;
    }

    p {
        margin: 5px 0;
        font-size: 14px;
        color: #cccccc;
    }

    .formats {
        font-size: 12px;
        color: #999;
        margin-top: 10px;
    }

    .file-group {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 15px;
        justify-content: center;
